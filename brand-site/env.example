VITE_BADMINTON_API_BASE_URL=http://localhost:8080
# Продакшен напрямую: https://badminton-service.website
# На https://app.badminton-service.website API base выставляется в коде автоматически.

# Set to false to use real backend API instead of mocks
# Default: true (use mocks)
VITE_BADMINTON_USE_MOCKS=true

